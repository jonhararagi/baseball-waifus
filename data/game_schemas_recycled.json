        "soft_pity_start": 75,
        "hard_pity": 90,
        "lower_rarity_guarantee_pull": 10
      },
      "warning": "Reference values are not Baseball Waifus balance and must not be consumed as live rates."
    }
  },
  "match_dto": {
    "type": "CombatInitDTO",
    "match_id": "string",
    "state": {
      "inning": 1,
