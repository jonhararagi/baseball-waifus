    },
    "transport_notes": {
      "authoritative_result": "Godot gameplay core or configured authoritative service",
      "frontend_role": "presentation_only",
      "aiohttp_role": "transport/serialization only",
      "renderer_must_not": [
        "change probabilities",
        "change stats",
        "choose rewards",
        "resolve baseball outcomes"
      ]
    }
  }
}
